{
  "name": "streamhero",
  "version": "1.0.0",
  "description": "Synchronized local network and YouTube watch party application",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "electron:start": "electron electron/main.js",
    "electron:build": "electron-builder --win"
  },
  "keywords": [
    "watch-party",
    "video-streaming",
    "socketio",
    "lan-sync",
    "youtube-sync"
  ],
  "author": "Nishant",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ip": "^2.0.1",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.streamhero.watchparty",
    "productName": "StreamHero",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "public/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ]
  }
}
